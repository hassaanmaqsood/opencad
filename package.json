{
  "name": "open-parametric-cad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based parametric B-Rep CAD application using a Zig WebAssembly kernel, C++ Differential Oracle Harness, and Three.js Web Worker frontend",
  "workspaces": [
    "web-app",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix web-app run dev",
    "build": "npm run build:kernel && npm run build:sdk && npm run build:core && npm --prefix web-app run build",
    "build:kernel": "cd kernel-zig && zig build",
    "build:sdk": "npm --prefix packages/kernel-sdk run build",
    "build:core": "npm --prefix packages/core-sdk run build",
    "build:dist": "node scripts/build_dist_publish.js",
    "test": "npm run test:kernel && npm run test:oracle && npm run test:web",
    "test:kernel": "cd kernel-zig && zig build test --summary all",
    "test:oracle": "cd oracle-harness/build && make -j$(nproc) && ./cad_differential_runner",
    "test:web": "npm --prefix web-app run test",
    "test:sdk": "npm --prefix packages/kernel-sdk test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build:pages": "node scripts/build_github_pages.js"
  },
  "keywords": [
    "cad",
    "b-rep",
    "parametric",
    "webassembly",
    "zig",
    "threejs",
    "opencascade"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "markdown-it-mathjax3": "^4.3.2",
    "vitepress": "^1.6.4"
  }
}

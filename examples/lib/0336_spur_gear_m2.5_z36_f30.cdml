<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="module" value="2.50" min="0.5" max="10.0" unit="mm"/>
    <var id="teeth" value="36" min="10" max="120" unit=""/>
    <var id="bore_dia" value="12.50" min="4.0" max="50.0" unit="mm"/>
    <var id="face_width" value="30.00" min="5.0" max="100.0" unit="mm"/>
    <expr id="pitch_dia" expr="module * teeth"/>
    <assert expr="pitch_dia > bore_dia * 2.0" message="Pitch circle must exceed bore diameter" level="error"/>
  </defs>

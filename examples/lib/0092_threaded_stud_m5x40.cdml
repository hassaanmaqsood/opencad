<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="stud_d" value="5.00" min="4.00" max="6.00" unit="mm"/>
    <var id="stud_l" value="40.00" min="20.00" max="60.00" unit="mm"/>
    <var id="pitch" value="0.80" min="0.40" max="1.60" unit="mm"/>
    <expr id="turns" expr="stud_l / pitch"/>
  </defs>
  <body>
    <chart id="ch_xy">
      <vars>
        <vec3 id="p0" x="0.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e1" x="1.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e2" x="0.0" y="1.0" z="0.0" fixed="true"/>
      </vars>
    </chart>
    <sketch id="sk_tip" chart="ch_xy">
      <vars>
        <point2d id="tp_0" u="1.9289" v="0.0000"/>
        <point2d id="tp_1" u="1.8632" v="0.4992"/>
        <point2d id="tp_2" u="1.6705" v="0.9645"/>
        <point2d id="tp_3" u="1.3639" v="1.3639"/>
        <point2d id="tp_4" u="0.9645" v="1.6705"/>
        <point2d id="tp_5" u="0.4992" v="1.8632"/>
        <point2d id="tp_6" u="0.0000" v="1.9289"/>
        <point2d id="tp_7" u="-0.4992" v="1.8632"/>
        <point2d id="tp_8" u="-0.9645" v="1.6705"/>
        <point2d id="tp_9" u="-1.3639" v="1.3639"/>
        <point2d id="tp_10" u="-1.6705" v="0.9645"/>
        <point2d id="tp_11" u="-1.8632" v="0.4992"/>
        <point2d id="tp_12" u="-1.9289" v="0.0000"/>
        <point2d id="tp_13" u="-1.8632" v="-0.4992"/>
        <point2d id="tp_14" u="-1.6705" v="-0.9645"/>
        <point2d id="tp_15" u="-1.3639" v="-1.3639"/>
        <point2d id="tp_16" u="-0.9645" v="-1.6705"/>
        <point2d id="tp_17" u="-0.4992" v="-1.8632"/>
        <point2d id="tp_18" u="-0.0000" v="-1.9289"/>
        <point2d id="tp_19" u="0.4992" v="-1.8632"/>
        <point2d id="tp_20" u="0.9645" v="-1.6705"/>
        <point2d id="tp_21" u="1.3639" v="-1.3639"/>
        <point2d id="tp_22" u="1.6705" v="-0.9645"/>
        <point2d id="tp_23" u="1.8632" v="-0.4992"/>
      </vars>
      <wire id="w_tip" closed="true" role="outer">
        <line p0="tp_0" p1="tp_1"/>
        <line p0="tp_1" p1="tp_2"/>
        <line p0="tp_2" p1="tp_3"/>
        <line p0="tp_3" p1="tp_4"/>
        <line p0="tp_4" p1="tp_5"/>
        <line p0="tp_5" p1="tp_6"/>
        <line p0="tp_6" p1="tp_7"/>
        <line p0="tp_7" p1="tp_8"/>
        <line p0="tp_8" p1="tp_9"/>
        <line p0="tp_9" p1="tp_10"/>
        <line p0="tp_10" p1="tp_11"/>
        <line p0="tp_11" p1="tp_12"/>
        <line p0="tp_12" p1="tp_13"/>
        <line p0="tp_13" p1="tp_14"/>
        <line p0="tp_14" p1="tp_15"/>
        <line p0="tp_15" p1="tp_16"/>
        <line p0="tp_16" p1="tp_17"/>
        <line p0="tp_17" p1="tp_18"/>
        <line p0="tp_18" p1="tp_19"/>
        <line p0="tp_19" p1="tp_20"/>
        <line p0="tp_20" p1="tp_21"/>
        <line p0="tp_21" p1="tp_22"/>
        <line p0="tp_22" p1="tp_23"/>
        <line p0="tp_23" p1="tp_0"/>
      </wire>
    </sketch>
    <sketch id="sk_thd" chart="ch_xy">
      <vars>
        <point2d id="th_0" u="2.0093" v="0.0000"/>
        <point2d id="th_1" u="1.9408" v="0.5200"/>
        <point2d id="th_2" u="1.7401" v="1.0046"/>
        <point2d id="th_3" u="1.4208" v="1.4208"/>
        <point2d id="th_4" u="1.0319" v="1.7873"/>
        <point2d id="th_5" u="0.5483" v="2.0461"/>
        <point2d id="th_6" u="0.0000" v="2.1729"/>
        <point2d id="th_7" u="-0.5765" v="2.1515"/>
        <point2d id="th_8" u="-1.1410" v="1.9762"/>
        <point2d id="th_9" u="-1.6521" v="1.6521"/>
        <point2d id="th_10" u="-2.0706" v="1.1955"/>
        <point2d id="th_11" u="-2.3621" v="0.6329"/>
        <point2d id="th_12" u="-2.5000" v="0.0000"/>
        <point2d id="th_13" u="-2.4148" v="-0.6470"/>
        <point2d id="th_14" u="-2.1651" v="-1.2500"/>
        <point2d id="th_15" u="-1.7678" v="-1.7678"/>
        <point2d id="th_16" u="-1.2227" v="-2.1178"/>
        <point2d id="th_17" u="-0.6188" v="-2.3095"/>
        <point2d id="th_18" u="-0.0000" v="-2.3364"/>
        <point2d id="th_19" u="0.5906" v="-2.2041"/>
        <point2d id="th_20" u="1.1137" v="-1.9290"/>
        <point2d id="th_21" u="1.5364" v="-1.5364"/>
        <point2d id="th_22" u="1.8345" v="-1.0592"/>
        <point2d id="th_23" u="1.9935" v="-0.5342"/>
      </vars>
      <wire id="w_thd" closed="true" role="outer">
        <line p0="th_0" p1="th_1"/>
        <line p0="th_1" p1="th_2"/>
        <line p0="th_2" p1="th_3"/>
        <line p0="th_3" p1="th_4"/>
        <line p0="th_4" p1="th_5"/>
        <line p0="th_5" p1="th_6"/>
        <line p0="th_6" p1="th_7"/>
        <line p0="th_7" p1="th_8"/>
        <line p0="th_8" p1="th_9"/>
        <line p0="th_9" p1="th_10"/>
        <line p0="th_10" p1="th_11"/>
        <line p0="th_11" p1="th_12"/>
        <line p0="th_12" p1="th_13"/>
        <line p0="th_13" p1="th_14"/>
        <line p0="th_14" p1="th_15"/>
        <line p0="th_15" p1="th_16"/>
        <line p0="th_16" p1="th_17"/>
        <line p0="th_17" p1="th_18"/>
        <line p0="th_18" p1="th_19"/>
        <line p0="th_19" p1="th_20"/>
        <line p0="th_20" p1="th_21"/>
        <line p0="th_21" p1="th_22"/>
        <line p0="th_22" p1="th_23"/>
        <line p0="th_23" p1="th_0"/>
      </wire>
    </sketch>
    <brep id="b_solid">
      <sweep id="sw_thread" continuity="G1" cap-ends="true">
        <section v="0.0000" wire="w_tip"/>
        <section v="0.0200" wire="w_thd"/>
        <section v="0.9800" wire="w_thd"/>
        <section v="1.0000" wire="w_tip"/>
        <trajectory>
          <translate x="0" y="0" z-expr="ref(stud_l) * v"/>
          <rotate axis="0 0 1" angle-expr="2 * PI * ref(turns) * v"/>
        </trajectory>
      </sweep>
    </brep>
  </body>
  <exports>
    <tessellate target="b_solid" chord-tol="0.02" angle-tol="0.05"/>
    <step target="b_solid" filename="threaded_stud_m5x40.step" schema="AP214"/>
    <stl target="b_solid" filename="threaded_stud_m5x40.stl" binary="true"/>
  </exports>
</cdml>

<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="fan_frame" value="120.00" min="30.0" max="140.0" unit="mm"/>
    <var id="duct_bore" value="116.00" min="25.0" max="135.0" unit="mm"/>
    <var id="baffle_thk" value="11.00" min="2.0" max="25.0" unit="mm"/>
    <assert expr="fan_frame > duct_bore" message="Frame must encompass airflow bore" level="error"/>
  </defs>
  <body>
    <chart id="ch_xy">
      <vars>
        <vec3 id="p0" x="0.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e1" x="1.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e2" x="0.0" y="1.0" z="0.0" fixed="false"/>
      </vars>
      <constraints>
        <residual id="u2" expr="dot(e2, e2) - 1.0"/>
        <residual id="or" expr="dot(e1, e2)"/>
        <residual id="pz" expr="dot(e2, vec3(0, 0, 1))"/>
      </constraints>
    </chart>
    <sketch id="sk_duct" chart="ch_xy" max-iter="100">
      <vars>
                <point2d id="fn_0" u="-60.0000" v="-60.0000"/>
        <point2d id="fn_1" u="60.0000" v="-60.0000"/>
        <point2d id="fn_2" u="60.0000" v="60.0000"/>
        <point2d id="fn_3" u="-60.0000" v="60.0000"/>
                <point2d id="dt_0" u="58.0000" v="0.0000"/>
        <point2d id="dt_1" u="56.0237" v="15.0115"/>
        <point2d id="dt_2" u="50.2295" v="29.0000"/>
        <point2d id="dt_3" u="41.0122" v="41.0122"/>
        <point2d id="dt_4" u="29.0000" v="50.2295"/>
        <point2d id="dt_5" u="15.0115" v="56.0237"/>
        <point2d id="dt_6" u="0.0000" v="58.0000"/>
        <point2d id="dt_7" u="-15.0115" v="56.0237"/>
        <point2d id="dt_8" u="-29.0000" v="50.2295"/>
        <point2d id="dt_9" u="-41.0122" v="41.0122"/>
        <point2d id="dt_10" u="-50.2295" v="29.0000"/>
        <point2d id="dt_11" u="-56.0237" v="15.0115"/>
        <point2d id="dt_12" u="-58.0000" v="0.0000"/>
        <point2d id="dt_13" u="-56.0237" v="-15.0115"/>
        <point2d id="dt_14" u="-50.2295" v="-29.0000"/>
        <point2d id="dt_15" u="-41.0122" v="-41.0122"/>
        <point2d id="dt_16" u="-29.0000" v="-50.2295"/>
        <point2d id="dt_17" u="-15.0115" v="-56.0237"/>
        <point2d id="dt_18" u="-0.0000" v="-58.0000"/>
        <point2d id="dt_19" u="15.0115" v="-56.0237"/>
        <point2d id="dt_20" u="29.0000" v="-50.2295"/>
        <point2d id="dt_21" u="41.0122" v="-41.0122"/>
        <point2d id="dt_22" u="50.2295" v="-29.0000"/>
        <point2d id="dt_23" u="56.0237" v="-15.0115"/>
      </vars>
      <wire id="w_outer" closed="true" role="outer">
                <line p0="fn_0" p1="fn_1"/>
        <line p0="fn_1" p1="fn_2"/>
        <line p0="fn_2" p1="fn_3"/>
        <line p0="fn_3" p1="fn_0"/>
      </wire>
      <wire id="w_inner" closed="true" role="inner">
                <line p0="dt_0" p1="dt_1"/>
        <line p0="dt_1" p1="dt_2"/>
        <line p0="dt_2" p1="dt_3"/>
        <line p0="dt_3" p1="dt_4"/>
        <line p0="dt_4" p1="dt_5"/>
        <line p0="dt_5" p1="dt_6"/>
        <line p0="dt_6" p1="dt_7"/>
        <line p0="dt_7" p1="dt_8"/>
        <line p0="dt_8" p1="dt_9"/>
        <line p0="dt_9" p1="dt_10"/>
        <line p0="dt_10" p1="dt_11"/>
        <line p0="dt_11" p1="dt_12"/>
        <line p0="dt_12" p1="dt_13"/>
        <line p0="dt_13" p1="dt_14"/>
        <line p0="dt_14" p1="dt_15"/>
        <line p0="dt_15" p1="dt_16"/>
        <line p0="dt_16" p1="dt_17"/>
        <line p0="dt_17" p1="dt_18"/>
        <line p0="dt_18" p1="dt_19"/>
        <line p0="dt_19" p1="dt_20"/>
        <line p0="dt_20" p1="dt_21"/>
        <line p0="dt_21" p1="dt_22"/>
        <line p0="dt_22" p1="dt_23"/>
        <line p0="dt_23" p1="dt_0"/>
      </wire>
    </sketch>
    <brep id="b_solid">
      <solid_extrude sketch="sk_duct" distance="baffle_thk" direction="vec3(0, 0, 1)"/>
    </brep>
  </body>
  <exports>
    <tessellate source="b_solid" linear_deflection="0.01" angular_deflection="0.1"/>
    <step source="b_solid" filename="cooling_fan_duct_baffle_120mm_v24.step" schema="AP214"/>
    <stl source="b_solid" filename="cooling_fan_duct_baffle_120mm_v24.stl" format="binary"/>
  </exports>
</cdml>

<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="shank_d" value="3.00" min="2.40" max="3.60" unit="mm"/>
    <var id="shank_l" value="25.00" min="12.50" max="50.00" unit="mm"/>
    <var id="head_s" value="5.50" min="4.40" max="7.15" unit="mm"/>
    <var id="head_h" value="2.10" min="1.05" max="3.15" unit="mm"/>
    <var id="pitch" value="0.50" min="0.25" max="1.00" unit="mm"/>
    <var id="thread_l" value="12.00" min="1.50" max="25.00" unit="mm"/>
    <expr id="total_l" expr="shank_l + head_h"/>
    <expr id="v_thd" expr="thread_l / total_l"/>
    <expr id="turns" expr="thread_l / pitch"/>
  </defs>
  <body>

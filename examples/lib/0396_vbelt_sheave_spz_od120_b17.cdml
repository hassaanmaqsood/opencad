<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="sheave_od" value="120.00" min="96.00" max="144.00" unit="mm"/>
    <var id="sheave_bore" value="17.00" min="13.60" max="20.40" unit="mm"/>
    <var id="sheave_w" value="25.00" min="12.0" max="60.0" unit="mm"/>
    <assert expr="sheave_od > sheave_bore * 2.5" message="Sheave OD must safely accommodate V-groove" level="error"/>
  </defs>
  <body>
    <chart id="ch_revolve">
      <vars>
        <vec3 id="p0" x="0.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e1" x="1.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e2" x="0.0" y="0.0" z="1.0" fixed="false"/>
      </vars>
      <constraints>
        <residual id="u2" expr="dot(e2, e2) - 1.0"/>
        <residual id="or" expr="dot(e1, e2)"/>
        <residual id="py" expr="dot(e2, vec3(0, 1, 0))"/>
      </constraints>
    </chart>
    <sketch id="sk_sheave" chart="ch_revolve" max-iter="100">
      <vars>
                <point2d id="p0" u="8.5000" v="0.0"/>
        <point2d id="p1" u="60.0000" v="0.0"/>
        <point2d id="p2" u="48.0000" v="12.5000"/>
        <point2d id="p3" u="60.0000" v="25.0000"/>
        <point2d id="p4" u="8.5000" v="25.0000"/>
      </vars>
      <wire id="w_sheave" closed="true" role="outer">
                <line p0="p0" p1="p1"/>
        <line p0="p1" p1="p2"/>
        <line p0="p2" p1="p3"/>
        <line p0="p3" p1="p4"/>
        <line p0="p4" p1="p0"/>
      </wire>
    </sketch>
    <brep id="b_solid">
      <solid_revolve sketch="sk_sheave" axis_origin="vec3(0, 0, 0)" axis_direction="vec3(0, 0, 1)" angle="360.0"/>
    </brep>
  </body>
  <exports>
    <tessellate source="b_solid" linear_deflection="0.01" angular_deflection="0.1"/>
    <step source="b_solid" filename="vbelt_sheave_spz_od120_b17.step" schema="AP214"/>
    <stl source="b_solid" filename="vbelt_sheave_spz_od120_b17.stl" format="binary"/>
  </exports>
</cdml>

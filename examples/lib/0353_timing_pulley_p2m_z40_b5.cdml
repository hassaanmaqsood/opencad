<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="tooth_pitch" value="2.00" min="1.0" max="10.0" unit="mm"/>
    <var id="tooth_count" value="40" min="10" max="80" unit=""/>
    <var id="bore_d" value="5.00" min="3.0" max="25.0" unit="mm"/>
    <var id="belt_width" value="10.00" min="6.0" max="40.0" unit="mm"/>
    <assert expr="tooth_count * tooth_pitch > bore_d * 4.0" message="Pitch perimeter must exceed bore envelope" level="error"/>
  </defs>
  <body>
    <chart id="ch_xy">
      <vars>
        <vec3 id="p0" x="0.0" y="0.0" z="0.0" fixed="true"/>

<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="shank_d" value="4.00" min="3.20" max="4.80" unit="mm"/>
    <var id="shank_l" value="16.00" min="8.00" max="32.00" unit="mm"/>
    <var id="head_d" value="7.20" min="5.76" max="9.36" unit="mm"/>
    <var id="head_h" value="2.80" min="1.40" max="4.20" unit="mm"/>
    <expr id="shank_r" expr="shank_d / 2.0"/>
    <expr id="head_r" expr="head_d / 2.0"/>
  </defs>
  <body>
    <chart id="ch_revolve">
      <vars>
        <vec3 id="p0" x="0.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e1" x="1.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e2" x="0.0" y="0.0" z="1.0" fixed="false"/>
      </vars>
      <constraints>
        <residual id="u2" expr="dot(e2, e2) - 1.0"/>
        <residual id="or" expr="dot(e1, e2)"/>
        <residual id="py" expr="dot(e2, vec3(0, 1, 0))"/>
      </constraints>
    </chart>
    <sketch id="sk_profile" chart="ch_revolve" max-iter="100">
      <vars>
                <point2d id="p0" u="0.0" v="0.0"/>
        <point2d id="p1" u="2.0000" v="0.0"/>
        <point2d id="p2" u="2.0000" v="16.0000"/>
        <point2d id="p3" u="3.6000" v="16.0000"/>
        <point2d id="p4" u="3.6000" v="18.8000"/>
        <point2d id="p5" u="0.0" v="18.8000"/>
      </vars>
      <wire id="w_profile" closed="true" role="outer">
                <line p0="p0" p1="p1"/>
        <line p0="p1" p1="p2"/>
        <line p0="p2" p1="p3"/>
        <line p0="p3" p1="p4"/>
        <line p0="p4" p1="p5"/>
        <line p0="p5" p1="p0"/>
      </wire>
    </sketch>
    <brep id="b_solid">
      <solid_revolve sketch="sk_profile" axis_origin="vec3(0, 0, 0)" axis_direction="vec3(0, 0, 1)" angle="360.0"/>
    </brep>
  </body>
  <exports>
    <tessellate source="b_solid" linear_deflection="0.01" angular_deflection="0.1"/>
    <step source="b_solid" filename="hex_bolt_m4x16.step" schema="AP214"/>
    <stl source="b_solid" filename="hex_bolt_m4x16.stl" format="binary"/>
  </exports>
</cdml>

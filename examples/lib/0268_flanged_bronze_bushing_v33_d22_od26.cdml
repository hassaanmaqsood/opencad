<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="bore_d" value="22.00" min="17.60" max="26.40" unit="mm"/>
    <var id="sleeve_od" value="26.00" min="20.80" max="31.20" unit="mm"/>
    <var id="flange_od" value="36.00" min="28.80" max="46.80" unit="mm"/>
    <var id="tot_len" value="30.00" min="10.0" max="80.0" unit="mm"/>
    <assert expr="flange_od > sleeve_od" message="Flange must exceed sleeve diameter" level="error"/>
  </defs>
  <body>
    <chart id="ch_revolve">
      <vars>
        <vec3 id="p0" x="0.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e1" x="1.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e2" x="0.0" y="0.0" z="1.0" fixed="false"/>
      </vars>
      <constraints>
        <residual id="u2" expr="dot(e2, e2) - 1.0"/>
        <residual id="or" expr="dot(e1, e2)"/>
        <residual id="py" expr="dot(e2, vec3(0, 1, 0))"/>
      </constraints>
    </chart>
    <sketch id="sk_bushing" chart="ch_revolve" max-iter="100">
      <vars>
                <point2d id="p0" u="11.0000" v="0.0"/>
        <point2d id="p1" u="18.0000" v="0.0"/>
        <point2d id="p2" u="18.0000" v="5.0000"/>
        <point2d id="p3" u="13.0000" v="5.0000"/>
        <point2d id="p4" u="13.0000" v="30.0000"/>
        <point2d id="p5" u="11.0000" v="30.0000"/>
      </vars>
      <wire id="w_bushing" closed="true" role="outer">
                <line p0="p0" p1="p1"/>
        <line p0="p1" p1="p2"/>
        <line p0="p2" p1="p3"/>
        <line p0="p3" p1="p4"/>
        <line p0="p4" p1="p5"/>
        <line p0="p5" p1="p0"/>
      </wire>
    </sketch>
    <brep id="b_solid">
      <solid_revolve sketch="sk_bushing" axis_origin="vec3(0, 0, 0)" axis_direction="vec3(0, 0, 1)" angle="360.0"/>
    </brep>
  </body>
  <exports>
    <tessellate source="b_solid" linear_deflection="0.01" angular_deflection="0.1"/>
    <step source="b_solid" filename="flanged_bronze_bushing_v33_d22_od26.step" schema="AP214"/>
    <stl source="b_solid" filename="flanged_bronze_bushing_v33_d22_od26.stl" format="binary"/>
  </exports>
</cdml>

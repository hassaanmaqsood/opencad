<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="shank_d" value="20.00" min="16.00" max="24.00" unit="mm"/>
    <var id="shank_l" value="100.00" min="50.00" max="200.00" unit="mm"/>
    <var id="head_s" value="30.00" min="24.00" max="39.00" unit="mm"/>
    <var id="head_h" value="14.00" min="7.00" max="21.00" unit="mm"/>
    <var id="pitch" value="2.50" min="1.25" max="5.00" unit="mm"/>
    <var id="thread_l" value="50.00" min="7.50" max="100.00" unit="mm"/>
    <expr id="total_l" expr="shank_l + head_h"/>
    <expr id="v_thd" expr="thread_l / total_l"/>
    <expr id="turns" expr="thread_l / pitch"/>
  </defs>
  <body>
    <chart id="ch_xy">
      <vars>
        <vec3 id="p0" x="0.0" y="0.0" z="0.0" fixed="true"/>

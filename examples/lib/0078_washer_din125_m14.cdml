    </sketch>
    <brep id="b_solid">
      <solid_extrude sketch="sk_washer" distance="thk" direction="vec3(0, 0, 1)"/>
    </brep>
  </body>
  <exports>
    <tessellate source="b_solid" linear_deflection="0.01" angular_deflection="0.1"/>
    <step source="b_solid" filename="washer_din125_m14.step" schema="AP214"/>
    <stl source="b_solid" filename="washer_din125_m14.stl" format="binary"/>
  </exports>
</cdml>

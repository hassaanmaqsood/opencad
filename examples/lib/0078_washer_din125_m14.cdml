<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="inner_dia" value="15.00" min="12.00" max="18.00" unit="mm"/>
    <var id="outer_dia" value="28.00" min="22.40" max="33.60" unit="mm"/>
    <var id="thk" value="2.50" min="1.25" max="5.00" unit="mm"/>
    <assert expr="outer_dia > inner_dia" message="Washer OD must exceed ID" level="error"/>
  </defs>
  <body>
    <chart id="ch_xy">
      <vars>
        <vec3 id="p0" x="0.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e1" x="1.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e2" x="0.0" y="1.0" z="0.0" fixed="false"/>
      </vars>
      <constraints>
        <residual id="u2" expr="dot(e2, e2) - 1.0"/>
        <residual id="or" expr="dot(e1, e2)"/>
        <residual id="pz" expr="dot(e2, vec3(0, 0, 1))"/>
      </constraints>
    </chart>
    <sketch id="sk_washer" chart="ch_xy" max-iter="100">
      <vars>

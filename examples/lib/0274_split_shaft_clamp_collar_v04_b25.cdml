<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="collar_bore" value="25.00" min="20.00" max="30.00" unit="mm"/>
    <var id="collar_od" value="47.00" min="37.60" max="56.40" unit="mm"/>
    <var id="collar_w" value="12.00" min="6.00" max="18.00" unit="mm"/>
    <assert expr="collar_od > collar_bore * 1.5" message="Collar OD must provide sufficient wall thickness" level="error"/>
  </defs>
  <body>
    <chart id="ch_xy">
      <vars>
        <vec3 id="p0" x="0.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e1" x="1.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e2" x="0.0" y="1.0" z="0.0" fixed="false"/>
      </vars>
      <constraints>
        <residual id="u2" expr="dot(e2, e2) - 1.0"/>
        <residual id="or" expr="dot(e1, e2)"/>
        <residual id="pz" expr="dot(e2, vec3(0, 0, 1))"/>
      </constraints>
    </chart>
    <sketch id="sk_collar" chart="ch_xy" max-iter="100">

<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="module" value="2.00" min="0.5" max="10.0" unit="mm"/>
    <var id="teeth" value="20" min="10" max="120" unit=""/>
    <var id="bore_dia" value="10.00" min="4.0" max="50.0" unit="mm"/>
    <var id="face_width" value="25.00" min="5.0" max="100.0" unit="mm"/>
    <expr id="pitch_dia" expr="module * teeth"/>
    <assert expr="pitch_dia > bore_dia * 2.0" message="Pitch circle must exceed bore diameter" level="error"/>
  </defs>
  <body>
    <chart id="ch_xy">
      <vars>
        <vec3 id="p0" x="0.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e1" x="1.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e2" x="0.0" y="1.0" z="0.0" fixed="false"/>
      </vars>
      <constraints>
        <residual id="u2" expr="dot(e2, e2) - 1.0"/>
        <residual id="or" expr="dot(e1, e2)"/>
        <residual id="pz" expr="dot(e2, vec3(0, 0, 1))"/>
      </constraints>
    </chart>

        <line p0="pb_8" p1="pb_9"/>
        <line p0="pb_9" p1="pb_10"/>
        <line p0="pb_10" p1="pb_11"/>
        <line p0="pb_11" p1="pb_12"/>
        <line p0="pb_12" p1="pb_13"/>
        <line p0="pb_13" p1="pb_14"/>
        <line p0="pb_14" p1="pb_15"/>
        <line p0="pb_15" p1="pb_16"/>
        <line p0="pb_16" p1="pb_17"/>
        <line p0="pb_17" p1="pb_18"/>
        <line p0="pb_18" p1="pb_19"/>
        <line p0="pb_19" p1="pb_0"/>
      </wire>
    </sketch>
    <brep id="b_solid">
      <solid_extrude sketch="sk_pulley" distance="belt_width" direction="vec3(0, 0, 1)"/>
    </brep>
  </body>
  <exports>
    <tessellate source="b_solid" linear_deflection="0.01" angular_deflection="0.1"/>
    <step source="b_solid" filename="timing_pulley_p2m_z16_b5.step" schema="AP214"/>
    <stl source="b_solid" filename="timing_pulley_p2m_z16_b5.stl" format="binary"/>
  </exports>
</cdml>

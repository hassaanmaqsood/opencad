<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="tooth_pitch" value="2.00" min="1.0" max="10.0" unit="mm"/>
    <var id="tooth_count" value="16" min="10" max="80" unit=""/>
    <var id="bore_d" value="5.00" min="3.0" max="25.0" unit="mm"/>
    <var id="belt_width" value="10.00" min="6.0" max="40.0" unit="mm"/>
    <assert expr="tooth_count * tooth_pitch > bore_d * 4.0" message="Pitch perimeter must exceed bore envelope" level="error"/>
  </defs>
  <body>
    <chart id="ch_xy">
      <vars>
        <vec3 id="p0" x="0.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e1" x="1.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e2" x="0.0" y="1.0" z="0.0" fixed="false"/>
      </vars>
      <constraints>
        <residual id="u2" expr="dot(e2, e2) - 1.0"/>
        <residual id="or" expr="dot(e1, e2)"/>
        <residual id="pz" expr="dot(e2, vec3(0, 0, 1))"/>
      </constraints>
    </chart>
    <sketch id="sk_pulley" chart="ch_xy" max-iter="100">
      <vars>
                <point2d id="pt_0" u="4.5930" v="0.0000"/>
        <point2d id="pt_1" u="3.0335" v="0.6034"/>

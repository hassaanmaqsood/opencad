        <point2d id="pt_30" u="4.2433" v="-1.7576"/>
        <point2d id="pt_31" u="3.0335" v="-0.6034"/>
                <point2d id="pb_0" u="2.5000" v="0.0000"/>
        <point2d id="pb_1" u="2.3776" v="0.7725"/>
        <point2d id="pb_2" u="2.0225" v="1.4695"/>
        <point2d id="pb_3" u="1.4695" v="2.0225"/>
        <point2d id="pb_4" u="0.7725" v="2.3776"/>
        <point2d id="pb_5" u="0.0000" v="2.5000"/>

        <point2d id="pt_23" u="-0.6034" v="-3.0335"/>
        <point2d id="pt_24" u="-0.0000" v="-4.5930"/>
        <point2d id="pt_25" u="0.6034" v="-3.0335"/>
        <point2d id="pt_26" u="1.7576" v="-4.2433"/>
        <point2d id="pt_27" u="1.7184" v="-2.5717"/>

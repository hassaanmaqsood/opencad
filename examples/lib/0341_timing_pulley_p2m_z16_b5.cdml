      </wire>
      <wire id="w_inner" closed="true" role="inner">
                <line p0="pb_0" p1="pb_1"/>
        <line p0="pb_1" p1="pb_2"/>
        <line p0="pb_2" p1="pb_3"/>
        <line p0="pb_3" p1="pb_4"/>
        <line p0="pb_4" p1="pb_5"/>

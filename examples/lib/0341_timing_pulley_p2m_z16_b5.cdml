        <point2d id="pb_8" u="-2.0225" v="1.4695"/>
        <point2d id="pb_9" u="-2.3776" v="0.7725"/>
        <point2d id="pb_10" u="-2.5000" v="0.0000"/>
        <point2d id="pb_11" u="-2.3776" v="-0.7725"/>
        <point2d id="pb_12" u="-2.0225" v="-1.4695"/>
        <point2d id="pb_13" u="-1.4695" v="-2.0225"/>
        <point2d id="pb_14" u="-0.7725" v="-2.3776"/>

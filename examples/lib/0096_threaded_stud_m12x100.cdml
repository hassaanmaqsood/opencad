<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="stud_d" value="12.00" min="9.60" max="14.40" unit="mm"/>
    <var id="stud_l" value="100.00" min="50.00" max="150.00" unit="mm"/>
    <var id="pitch" value="1.75" min="0.88" max="3.50" unit="mm"/>
    <expr id="stud_r" expr="stud_d / 2.0"/>
    <expr id="turns" expr="stud_l / pitch"/>
  </defs>
  <body>
    <chart id="ch_xy">
      <vars>
        <vec3 id="p0" x="0.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e1" x="1.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e2" x="0.0" y="1.0" z="0.0" fixed="false"/>
      </vars>
      <constraints>
        <residual id="u2" expr="dot(e2, e2) - 1.0"/>
        <residual id="or" expr="dot(e1, e2)"/>
        <residual id="pz" expr="dot(e2, vec3(0, 0, 1))"/>
      </constraints>
    </chart>
    <sketch id="sk_stud" chart="ch_xy" max-iter="100">
      <vars>
        <point2d id="v_0" u="6.0000" v="0.0000"/>
        <point2d id="v_1" u="5.5055" v="2.2805"/>
        <point2d id="v_2" u="4.1315" v="4.1315"/>
        <point2d id="v_3" u="2.1693" v="5.2372"/>
        <point2d id="v_4" u="0.0000" v="5.4633"/>
        <point2d id="v_5" u="-2.0121" v="4.8576"/>
        <point2d id="v_6" u="-3.5948" v="3.5948"/>
        <point2d id="v_7" u="-4.5893" v="1.9009"/>
        <point2d id="v_8" u="-4.9266" v="0.0000"/>
        <point2d id="v_9" u="-4.5893" v="-1.9009"/>
        <point2d id="v_10" u="-3.5948" v="-3.5948"/>
        <point2d id="v_11" u="-2.0121" v="-4.8576"/>
        <point2d id="v_12" u="-0.0000" v="-5.4633"/>
        <point2d id="v_13" u="2.1693" v="-5.2372"/>
        <point2d id="v_14" u="4.1315" v="-4.1315"/>
        <point2d id="v_15" u="5.5055" v="-2.2805"/>
      </vars>
      <wire id="w_outer" closed="true" role="outer">
        <line p0="v_0" p1="v_1"/>
        <line p0="v_1" p1="v_2"/>
        <line p0="v_2" p1="v_3"/>
        <line p0="v_3" p1="v_4"/>
        <line p0="v_4" p1="v_5"/>
        <line p0="v_5" p1="v_6"/>
        <line p0="v_6" p1="v_7"/>
        <line p0="v_7" p1="v_8"/>
        <line p0="v_8" p1="v_9"/>
        <line p0="v_9" p1="v_10"/>
        <line p0="v_10" p1="v_11"/>
        <line p0="v_11" p1="v_12"/>
        <line p0="v_12" p1="v_13"/>
        <line p0="v_13" p1="v_14"/>
        <line p0="v_14" p1="v_15"/>
        <line p0="v_15" p1="v_0"/>
      </wire>
    </sketch>
    <brep id="b_solid">
      <sweep id="sw_thread" sketch="sk_stud" cap-ends="true">
        <trajectory>
          <translate x="0" y="0" z-expr="ref(stud_l) * v"/>
          <rotate axis="0 0 1" angle-expr="2 * PI * ref(turns) * v"/>
        </trajectory>
      </sweep>
    </brep>
  </body>
  <exports>
    <tessellate source="b_solid" linear_deflection="0.01" angular_deflection="0.1"/>
    <step source="b_solid" filename="threaded_stud_m12x100.step" schema="AP214"/>
    <stl source="b_solid" filename="threaded_stud_m12x100.stl" format="binary"/>
  </exports>
</cdml>

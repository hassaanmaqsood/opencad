        <line p0="f_in_18" p1="f_in_19"/>
        <line p0="f_in_19" p1="f_in_20"/>
        <line p0="f_in_20" p1="f_in_21"/>
        <line p0="f_in_21" p1="f_in_22"/>
        <line p0="f_in_22" p1="f_in_23"/>
        <line p0="f_in_23" p1="f_in_0"/>
      </wire>
    </sketch>
    <brep id="b_solid">
      <solid_extrude sketch="sk_hub" distance="hub_len" direction="vec3(0, 0, 1)"/>
    </brep>
  </body>
  <exports>
    <tessellate source="b_solid" linear_deflection="0.01" angular_deflection="0.1"/>
    <step source="b_solid" filename="rigid_clamp_coupling_hub_v18_od55_b32.step" schema="AP214"/>
    <stl source="b_solid" filename="rigid_clamp_coupling_hub_v18_od55_b32.stl" format="binary"/>
  </exports>
</cdml>

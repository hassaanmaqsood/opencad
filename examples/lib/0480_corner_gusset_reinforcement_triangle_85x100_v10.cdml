<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="gusset_w" value="85.00" min="20.0" max="150.0" unit="mm"/>
    <var id="gusset_h" value="100.00" min="20.0" max="150.0" unit="mm"/>
    <var id="gusset_thk" value="6.00" min="2.0" max="25.0" unit="mm"/>
  </defs>
  <body>
    <chart id="ch_xy">
      <vars>
        <vec3 id="p0" x="0.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e1" x="1.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e2" x="0.0" y="1.0" z="0.0" fixed="false"/>
      </vars>
      <constraints>
        <residual id="u2" expr="dot(e2, e2) - 1.0"/>
        <residual id="or" expr="dot(e1, e2)"/>
        <residual id="pz" expr="dot(e2, vec3(0, 0, 1))"/>
      </constraints>
    </chart>
    <sketch id="sk_tri" chart="ch_xy" max-iter="100">
      <vars>
                <point2d id="v0" u="0.0" v="0.0"/>
        <point2d id="v1" u="85.0000" v="0.0"/>
        <point2d id="v2" u="0.0" v="100.0000"/>
      </vars>
      <wire id="w_outer" closed="true" role="outer">
                <line p0="v0" p1="v1"/>
        <line p0="v1" p1="v2"/>
        <line p0="v2" p1="v0"/>
      </wire>
    </sketch>
    <brep id="b_solid">
      <solid_extrude sketch="sk_tri" distance="gusset_thk" direction="vec3(0, 0, 1)"/>
    </brep>
  </body>
  <exports>
    <tessellate source="b_solid" linear_deflection="0.01" angular_deflection="0.1"/>
    <step source="b_solid" filename="corner_gusset_reinforcement_triangle_85x100_v10.step" schema="AP214"/>
    <stl source="b_solid" filename="corner_gusset_reinforcement_triangle_85x100_v10.stl" format="binary"/>
  </exports>
</cdml>

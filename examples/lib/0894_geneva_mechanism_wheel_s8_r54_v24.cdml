<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="wheel_radius" value="54.00" min="20.0" max="150.0" unit="mm"/>
    <var id="wheel_thk" value="12.00" min="4.0" max="30.0" unit="mm"/>
    <assert expr="wheel_radius > 15.0" message="Wheel radius must safely accommodate slot depth" level="error"/>
  </defs>
  <body>
    <chart id="ch_xy">
      <vars>
        <vec3 id="p0" x="0.0" y="0.0" z="0.0" fixed="true"/>

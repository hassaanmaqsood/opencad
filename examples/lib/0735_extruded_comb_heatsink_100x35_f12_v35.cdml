<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="heatsink_w" value="100.00" min="25.0" max="150.0" unit="mm"/>
    <var id="fin_height" value="35.00" min="10.0" max="60.0" unit="mm"/>
    <var id="heatsink_len" value="100.00" min="20.0" max="200.0" unit="mm"/>
    <assert expr="fin_height > 5.0" message="Fin height must provide adequate convection area" level="error"/>
  </defs>
  <body>
    <chart id="ch_xy">
      <vars>
        <vec3 id="p0" x="0.0" y="0.0" z="0.0" fixed="true"/>

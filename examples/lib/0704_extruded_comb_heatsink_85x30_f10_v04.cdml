    <brep id="b_solid">
      <solid_extrude sketch="sk_heatsink" distance="heatsink_len" direction="vec3(0, 0, 1)"/>
    </brep>
  </body>
  <exports>
    <tessellate source="b_solid" linear_deflection="0.01" angular_deflection="0.1"/>
    <step source="b_solid" filename="extruded_comb_heatsink_85x30_f10_v04.step" schema="AP214"/>

        <point2d id="fn_3_b" u="31.0250" v="4.0000"/>
        <point2d id="fn_2_r" u="25.5000" v="34.0000"/>
        <point2d id="fn_2_l" u="22.5250" v="34.0000"/>
        <point2d id="fn_2_b" u="22.5250" v="4.0000"/>
        <point2d id="fn_1_r" u="17.0000" v="34.0000"/>
        <point2d id="fn_1_l" u="14.0250" v="34.0000"/>
        <point2d id="fn_1_b" u="14.0250" v="4.0000"/>
        <point2d id="fn_0_r" u="8.5000" v="34.0000"/>
        <point2d id="fn_0_l" u="5.5250" v="34.0000"/>
        <point2d id="fn_0_b" u="5.5250" v="4.0000"/>
        <point2d id="c_end" u="0.0" v="4.0000"/>
      </vars>
      <wire id="w_outer" closed="true" role="outer">
                <line p0="c0" p1="c1"/>
        <line p0="c1" p1="c2"/>
        <line p0="c2" p1="fn_9_r"/>
        <line p0="fn_9_r" p1="fn_9_l"/>
        <line p0="fn_9_l" p1="fn_9_b"/>
        <line p0="fn_9_b" p1="fn_8_r"/>

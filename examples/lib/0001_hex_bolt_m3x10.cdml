<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="shank_d" value="3.00" min="2.40" max="3.60" unit="mm"/>
    <var id="shank_l" value="10.00" min="5.00" max="20.00" unit="mm"/>
    <var id="head_d" value="5.40" min="4.32" max="7.02" unit="mm"/>
    <var id="head_h" value="2.10" min="1.05" max="3.15" unit="mm"/>
    <var id="pitch" value="0.50" min="0.25" max="1.00" unit="mm"/>
    <expr id="shank_r" expr="shank_d / 2.0"/>
    <expr id="head_r" expr="head_d / 2.0"/>
    <expr id="minor_r" expr="shank_r - 0.6134 * pitch"/>
  </defs>
  <body>

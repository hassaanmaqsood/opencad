<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="shank_d" value="12.00" min="9.60" max="14.40" unit="mm"/>
    <var id="shank_l" value="100.00" min="50.00" max="200.00" unit="mm"/>
    <var id="head_s" value="18.00" min="14.40" max="23.40" unit="mm"/>
    <var id="head_h" value="8.40" min="4.20" max="12.60" unit="mm"/>
    <var id="pitch" value="1.75" min="0.88" max="3.50" unit="mm"/>
    <var id="thread_l" value="35.00" min="5.25" max="100.00" unit="mm"/>
    <expr id="total_l" expr="shank_l + head_h"/>
    <expr id="v_thd" expr="thread_l / total_l"/>
    <expr id="turns" expr="thread_l / pitch"/>
  </defs>

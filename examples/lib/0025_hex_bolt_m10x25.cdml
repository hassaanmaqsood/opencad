<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="shank_d" value="10.00" min="8.00" max="12.00" unit="mm"/>
    <var id="shank_l" value="25.00" min="12.50" max="50.00" unit="mm"/>
    <var id="head_d" value="18.00" min="14.40" max="23.40" unit="mm"/>
    <var id="head_h" value="7.00" min="3.50" max="10.50" unit="mm"/>
    <var id="pitch" value="1.50" min="0.75" max="3.00" unit="mm"/>
    <expr id="shank_r" expr="shank_d / 2.0"/>
    <expr id="head_r" expr="head_d / 2.0"/>
    <expr id="minor_r" expr="shank_r - 0.6134 * pitch"/>
  </defs>
  <body>
    <chart id="ch_revolve">
      <vars>
        <vec3 id="p0" x="0.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e1" x="1.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e2" x="0.0" y="0.0" z="1.0" fixed="false"/>
      </vars>
      <constraints>
        <residual id="u2" expr="dot(e2, e2) - 1.0"/>
        <residual id="or" expr="dot(e1, e2)"/>
        <residual id="py" expr="dot(e2, vec3(0, 1, 0))"/>
      </constraints>
    </chart>

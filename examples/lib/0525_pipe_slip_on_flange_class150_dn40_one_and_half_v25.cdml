    <step source="b_solid" filename="pipe_slip_on_flange_class150_dn40_one_and_half_v25.step" schema="AP214"/>
    <stl source="b_solid" filename="pipe_slip_on_flange_class150_dn40_one_and_half_v25.stl" format="binary"/>

<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="flange_od" value="152.40" min="101.60" max="190.50" unit="mm"/>
    <var id="pipe_bore" value="57.96" min="38.64" max="72.45" unit="mm"/>
    <var id="flange_thk" value="21.00" min="10.0" max="60.0" unit="mm"/>
    <assert expr="flange_od > pipe_bore * 1.5" message="Flange OD must accommodate sealing face and bolt circle" level="error"/>
  </defs>
  <body>
    <chart id="ch_xy">
      <vars>
        <vec3 id="p0" x="0.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e1" x="1.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e2" x="0.0" y="1.0" z="0.0" fixed="false"/>
      </vars>
      <constraints>
        <residual id="u2" expr="dot(e2, e2) - 1.0"/>
        <residual id="or" expr="dot(e1, e2)"/>
        <residual id="pz" expr="dot(e2, vec3(0, 0, 1))"/>
      </constraints>
    </chart>

<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="stud_d" value="10.00" min="8.00" max="12.00" unit="mm"/>
    <var id="stud_l" value="80.00" min="40.00" max="120.00" unit="mm"/>
    <var id="pitch" value="1.50" min="0.75" max="3.00" unit="mm"/>
    <expr id="stud_r" expr="stud_d / 2.0"/>
    <expr id="turns" expr="stud_l / pitch"/>
  </defs>
  <body>
    <chart id="ch_xy">
      <vars>
        <vec3 id="p0" x="0.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e1" x="1.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e2" x="0.0" y="1.0" z="0.0" fixed="false"/>
      </vars>
      <constraints>
        <residual id="u2" expr="dot(e2, e2) - 1.0"/>
        <residual id="or" expr="dot(e1, e2)"/>
        <residual id="pz" expr="dot(e2, vec3(0, 0, 1))"/>
      </constraints>
    </chart>
    <sketch id="sk_stud" chart="ch_xy" max-iter="100">
      <vars>
        <point2d id="v_0" u="5.0000" v="0.0000"/>
        <point2d id="v_1" u="4.5870" v="1.9000"/>
        <point2d id="v_2" u="3.4403" v="3.4403"/>
        <point2d id="v_3" u="1.8047" v="4.3570"/>
        <point2d id="v_4" u="0.0000" v="4.5400"/>
        <point2d id="v_5" u="-1.6700" v="4.0317"/>
        <point2d id="v_6" u="-2.9802" v="2.9802"/>
        <point2d id="v_7" u="-3.8017" v="1.5747"/>
        <point2d id="v_8" u="-4.0799" v="0.0000"/>
        <point2d id="v_9" u="-3.8017" v="-1.5747"/>
        <point2d id="v_10" u="-2.9802" v="-2.9802"/>
        <point2d id="v_11" u="-1.6700" v="-4.0317"/>
        <point2d id="v_12" u="-0.0000" v="-4.5400"/>
        <point2d id="v_13" u="1.8047" v="-4.3570"/>
        <point2d id="v_14" u="3.4403" v="-3.4403"/>
        <point2d id="v_15" u="4.5870" v="-1.9000"/>
      </vars>
      <wire id="w_outer" closed="true" role="outer">
        <line p0="v_0" p1="v_1"/>
        <line p0="v_1" p1="v_2"/>
        <line p0="v_2" p1="v_3"/>
        <line p0="v_3" p1="v_4"/>
        <line p0="v_4" p1="v_5"/>
        <line p0="v_5" p1="v_6"/>
        <line p0="v_6" p1="v_7"/>
        <line p0="v_7" p1="v_8"/>
        <line p0="v_8" p1="v_9"/>
        <line p0="v_9" p1="v_10"/>
        <line p0="v_10" p1="v_11"/>
        <line p0="v_11" p1="v_12"/>
        <line p0="v_12" p1="v_13"/>
        <line p0="v_13" p1="v_14"/>
        <line p0="v_14" p1="v_15"/>
        <line p0="v_15" p1="v_0"/>
      </wire>
    </sketch>
    <brep id="b_solid">
      <sweep id="sw_thread" sketch="sk_stud" cap-ends="true">
        <trajectory>
          <translate x="0" y="0" z-expr="ref(stud_l) * v"/>
          <rotate axis="0 0 1" angle-expr="2 * PI * ref(turns) * v"/>
        </trajectory>
      </sweep>
    </brep>
  </body>
  <exports>
    <tessellate source="b_solid" linear_deflection="0.01" angular_deflection="0.1"/>
    <step source="b_solid" filename="threaded_stud_m10x80.step" schema="AP214"/>
    <stl source="b_solid" filename="threaded_stud_m10x80.stl" format="binary"/>
  </exports>
</cdml>

    <brep id="b_solid">
      <solid_extrude sketch="sk_collar" distance="collar_w" direction="vec3(0, 0, 1)"/>
    </brep>
  </body>
  <exports>
    <tessellate source="b_solid" linear_deflection="0.01" angular_deflection="0.1"/>
    <step source="b_solid" filename="split_shaft_clamp_collar_v09_b20.step" schema="AP214"/>
    <stl source="b_solid" filename="split_shaft_clamp_collar_v09_b20.stl" format="binary"/>
  </exports>
</cdml>

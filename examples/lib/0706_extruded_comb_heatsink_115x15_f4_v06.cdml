<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="heatsink_w" value="115.00" min="25.0" max="150.0" unit="mm"/>
    <var id="fin_height" value="15.00" min="10.0" max="60.0" unit="mm"/>
    <var id="heatsink_len" value="40.00" min="20.0" max="200.0" unit="mm"/>
    <assert expr="fin_height > 5.0" message="Fin height must provide adequate convection area" level="error"/>
  </defs>
  <body>
    <chart id="ch_xy">
      <vars>
        <vec3 id="p0" x="0.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e1" x="1.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e2" x="0.0" y="1.0" z="0.0" fixed="false"/>
      </vars>
      <constraints>
        <residual id="u2" expr="dot(e2, e2) - 1.0"/>
        <residual id="or" expr="dot(e1, e2)"/>
        <residual id="pz" expr="dot(e2, vec3(0, 0, 1))"/>
      </constraints>
    </chart>
    <sketch id="sk_heatsink" chart="ch_xy" max-iter="100">
      <vars>
                <point2d id="c0" u="0.0" v="0.0"/>
        <point2d id="c1" u="115.0000" v="0.0"/>
        <point2d id="c2" u="115.0000" v="7.0000"/>
        <point2d id="fn_3_r" u="115.0000" v="22.0000"/>
        <point2d id="fn_3_l" u="104.9375" v="22.0000"/>
        <point2d id="fn_3_b" u="104.9375" v="7.0000"/>
        <point2d id="fn_2_r" u="86.2500" v="22.0000"/>
        <point2d id="fn_2_l" u="76.1875" v="22.0000"/>
        <point2d id="fn_2_b" u="76.1875" v="7.0000"/>
        <point2d id="fn_1_r" u="57.5000" v="22.0000"/>
        <point2d id="fn_1_l" u="47.4375" v="22.0000"/>
        <point2d id="fn_1_b" u="47.4375" v="7.0000"/>
        <point2d id="fn_0_r" u="28.7500" v="22.0000"/>
        <point2d id="fn_0_l" u="18.6875" v="22.0000"/>
        <point2d id="fn_0_b" u="18.6875" v="7.0000"/>
        <point2d id="c_end" u="0.0" v="7.0000"/>
      </vars>
      <wire id="w_outer" closed="true" role="outer">
                <line p0="c0" p1="c1"/>
        <line p0="c1" p1="c2"/>
        <line p0="c2" p1="fn_3_r"/>
        <line p0="fn_3_r" p1="fn_3_l"/>
        <line p0="fn_3_l" p1="fn_3_b"/>
        <line p0="fn_3_b" p1="fn_2_r"/>
        <line p0="fn_2_r" p1="fn_2_l"/>
        <line p0="fn_2_l" p1="fn_2_b"/>
        <line p0="fn_2_b" p1="fn_1_r"/>
        <line p0="fn_1_r" p1="fn_1_l"/>
        <line p0="fn_1_l" p1="fn_1_b"/>
        <line p0="fn_1_b" p1="fn_0_r"/>
        <line p0="fn_0_r" p1="fn_0_l"/>
        <line p0="fn_0_l" p1="fn_0_b"/>
        <line p0="fn_0_b" p1="c_end"/>
        <line p0="c_end" p1="c0"/>
      </wire>
    </sketch>
    <brep id="b_solid">
      <solid_extrude sketch="sk_heatsink" distance="heatsink_len" direction="vec3(0, 0, 1)"/>
    </brep>
  </body>
  <exports>
    <tessellate source="b_solid" linear_deflection="0.01" angular_deflection="0.1"/>
    <step source="b_solid" filename="extruded_comb_heatsink_115x15_f4_v06.step" schema="AP214"/>
    <stl source="b_solid" filename="extruded_comb_heatsink_115x15_f4_v06.stl" format="binary"/>
  </exports>
</cdml>

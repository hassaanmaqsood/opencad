<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="pin_d" value="7.50" min="6.00" max="9.00" unit="mm"/>
    <var id="pin_l" value="35.00" min="17.50" max="70.00" unit="mm"/>
    <expr id="pin_r" expr="pin_d / 2.0"/>
  </defs>
  <body>
    <chart id="ch_xy">
      <vars>
        <vec3 id="p0" x="0.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e1" x="1.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e2" x="0.0" y="1.0" z="0.0" fixed="false"/>
      </vars>
      <constraints>
        <residual id="u2" expr="dot(e2, e2) - 1.0"/>
        <residual id="or" expr="dot(e1, e2)"/>
        <residual id="pz" expr="dot(e2, vec3(0, 0, 1))"/>
      </constraints>
    </chart>
    <sketch id="sk_pin" chart="ch_xy" max-iter="100">
      <vars>
                <point2d id="vp_0" u="3.7500" v="0.0000"/>
        <point2d id="vp_1" u="3.5665" v="1.1588"/>
        <point2d id="vp_2" u="3.0338" v="2.2042"/>
        <point2d id="vp_3" u="2.2042" v="3.0338"/>
        <point2d id="vp_4" u="1.1588" v="3.5665"/>
        <point2d id="vp_5" u="0.0000" v="3.7500"/>
        <point2d id="vp_6" u="-1.1588" v="3.5665"/>
        <point2d id="vp_7" u="-2.2042" v="3.0338"/>
        <point2d id="vp_8" u="-3.0338" v="2.2042"/>
        <point2d id="vp_9" u="-3.5665" v="1.1588"/>
        <point2d id="vp_10" u="-3.7500" v="0.0000"/>
        <point2d id="vp_11" u="-3.5665" v="-1.1588"/>
        <point2d id="vp_12" u="-3.0338" v="-2.2042"/>
        <point2d id="vp_13" u="-2.2042" v="-3.0338"/>
        <point2d id="vp_14" u="-1.1588" v="-3.5665"/>
        <point2d id="vp_15" u="-0.0000" v="-3.7500"/>
        <point2d id="vp_16" u="1.1588" v="-3.5665"/>
        <point2d id="vp_17" u="2.2042" v="-3.0338"/>
        <point2d id="vp_18" u="3.0338" v="-2.2042"/>
        <point2d id="vp_19" u="3.5665" v="-1.1588"/>
      </vars>
      <wire id="w_outer" closed="true" role="outer">
                <line p0="vp_0" p1="vp_1"/>
        <line p0="vp_1" p1="vp_2"/>
        <line p0="vp_2" p1="vp_3"/>
        <line p0="vp_3" p1="vp_4"/>
        <line p0="vp_4" p1="vp_5"/>
        <line p0="vp_5" p1="vp_6"/>
        <line p0="vp_6" p1="vp_7"/>
        <line p0="vp_7" p1="vp_8"/>
        <line p0="vp_8" p1="vp_9"/>
        <line p0="vp_9" p1="vp_10"/>
        <line p0="vp_10" p1="vp_11"/>
        <line p0="vp_11" p1="vp_12"/>
        <line p0="vp_12" p1="vp_13"/>
        <line p0="vp_13" p1="vp_14"/>
        <line p0="vp_14" p1="vp_15"/>
        <line p0="vp_15" p1="vp_16"/>
        <line p0="vp_16" p1="vp_17"/>
        <line p0="vp_17" p1="vp_18"/>
        <line p0="vp_18" p1="vp_19"/>
        <line p0="vp_19" p1="vp_0"/>
      </wire>
    </sketch>
    <brep id="b_solid">
      <solid_extrude sketch="sk_pin" distance="pin_l" direction="vec3(0, 0, 1)"/>
    </brep>
  </body>
  <exports>
    <tessellate source="b_solid" linear_deflection="0.01" angular_deflection="0.1"/>
    <step source="b_solid" filename="precision_dowel_pin_v14_d7.5x35.step" schema="AP214"/>
    <stl source="b_solid" filename="precision_dowel_pin_v14_d7.5x35.stl" format="binary"/>
  </exports>
</cdml>

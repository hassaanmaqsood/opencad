<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="shank_d" value="8.00" min="6.40" max="9.60" unit="mm"/>
    <var id="shank_l" value="20.00" min="10.00" max="40.00" unit="mm"/>
    <var id="head_s" value="13.00" min="10.40" max="16.90" unit="mm"/>
    <var id="head_h" value="5.60" min="2.80" max="8.40" unit="mm"/>
    <var id="pitch" value="1.25" min="0.63" max="2.50" unit="mm"/>
    <var id="thread_l" value="19.25" min="3.75" max="20.00" unit="mm"/>
    <expr id="total_l" expr="shank_l + head_h"/>
    <expr id="v_thd" expr="thread_l / total_l"/>
    <expr id="turns" expr="thread_l / pitch"/>
  </defs>

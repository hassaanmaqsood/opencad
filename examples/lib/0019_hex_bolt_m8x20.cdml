    <brep id="b_solid">
      <sweep id="sw_bolt" continuity="G1" cap-ends="true">
        <section v="0.0000" wire="w_tip"/>
        <section v="0.0366" wire="w_thd"/>
        <section v="0.6934" wire="w_thd"/>
        <section v="0.7520" wire="w_shk"/>
        <section v="0.7772" wire="w_shk"/>
        <section v="0.7853" wire="w_hex"/>
        <section v="1.0000" wire="w_hex"/>
        <trajectory>
          <translate x="0" y="0" z-expr="ref(total_l) * v"/>
          <rotate axis="0 0 1" angle-expr="2 * PI * ref(turns) * (0.5 * (v + ref(v_thd) - abs_smooth(v - ref(v_thd), 0.001)) / ref(v_thd))"/>
        </trajectory>
      </sweep>
    </brep>
  </body>
  <exports>
    <tessellate target="b_solid" chord-tol="0.02" angle-tol="0.05"/>
    <step target="b_solid" filename="hex_bolt_m8x20.step" schema="AP214"/>
    <stl target="b_solid" filename="hex_bolt_m8x20.stl" binary="true"/>
  </exports>
</cdml>

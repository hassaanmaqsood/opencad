<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="shank_d" value="10.00" min="8.00" max="12.00" unit="mm"/>
    <var id="shank_l" value="30.00" min="15.00" max="60.00" unit="mm"/>
    <var id="head_s" value="16.00" min="12.80" max="20.80" unit="mm"/>
    <var id="head_h" value="7.00" min="3.50" max="10.50" unit="mm"/>
    <var id="pitch" value="1.50" min="0.75" max="3.00" unit="mm"/>
    <var id="thread_l" value="26.00" min="4.50" max="30.00" unit="mm"/>
    <expr id="total_l" expr="shank_l + head_h"/>
    <expr id="v_thd" expr="thread_l / total_l"/>
    <expr id="turns" expr="thread_l / pitch"/>
  </defs>

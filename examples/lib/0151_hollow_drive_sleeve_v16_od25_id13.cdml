    <var id="inner_d" value="13.00" min="10.40" max="15.60" unit="mm"/>
    <var id="length" value="95.00" min="47.50" max="142.50" unit="mm"/>
    <assert expr="outer_d > inner_d" message="Outer diameter must exceed bore" level="error"/>

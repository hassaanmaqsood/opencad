<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="shank_d" value="12.00" min="9.60" max="14.40" unit="mm"/>
    <var id="shank_l" value="30.00" min="15.00" max="60.00" unit="mm"/>
    <var id="head_d" value="21.60" min="17.28" max="28.08" unit="mm"/>
    <var id="head_h" value="8.40" min="4.20" max="12.60" unit="mm"/>
    <var id="pitch" value="1.75" min="0.88" max="3.50" unit="mm"/>
    <expr id="shank_r" expr="shank_d / 2.0"/>
    <expr id="head_r" expr="head_d / 2.0"/>
    <expr id="minor_r" expr="shank_r - 0.6134 * pitch"/>
  </defs>
  <body>

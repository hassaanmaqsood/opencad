        <line p0="f_in_23" p1="f_in_0"/>
      </wire>
    </sketch>
    <brep id="b_solid">
      <solid_extrude sketch="sk_hub" distance="hub_len" direction="vec3(0, 0, 1)"/>
    </brep>
  </body>
  <exports>
    <tessellate source="b_solid" linear_deflection="0.01" angular_deflection="0.1"/>
    <step source="b_solid" filename="rigid_clamp_coupling_hub_v07_od130_b12.step" schema="AP214"/>
    <stl source="b_solid" filename="rigid_clamp_coupling_hub_v07_od130_b12.stl" format="binary"/>
  </exports>
</cdml>

<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="shank_d" value="6.00" min="4.80" max="7.20" unit="mm"/>
    <var id="shank_l" value="40.00" min="20.00" max="80.00" unit="mm"/>
    <var id="head_s" value="10.00" min="8.00" max="13.00" unit="mm"/>
    <var id="head_h" value="4.20" min="2.10" max="6.30" unit="mm"/>
    <var id="pitch" value="1.00" min="0.50" max="2.00" unit="mm"/>
    <var id="thread_l" value="20.00" min="3.00" max="40.00" unit="mm"/>
    <expr id="total_l" expr="shank_l + head_h"/>
    <expr id="v_thd" expr="thread_l / total_l"/>
    <expr id="turns" expr="thread_l / pitch"/>
  </defs>

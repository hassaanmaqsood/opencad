    <var id="pipe_bore" value="218.79" min="134.64" max="252.45" unit="mm"/>
    <var id="flange_thk" value="33.02" min="10.0" max="60.0" unit="mm"/>
    <assert expr="flange_od > pipe_bore * 1.5" message="Flange OD must accommodate sealing face and bolt circle" level="error"/>
  </defs>
  <body>

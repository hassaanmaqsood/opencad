    <brep id="b_solid">
      <solid_extrude sketch="sk_bearing" distance="width_b" direction="vec3(0, 0, 1)"/>
    </brep>
  </body>
  <exports>
    <tessellate source="b_solid" linear_deflection="0.01" angular_deflection="0.1"/>
    <step source="b_solid" filename="deep_groove_bearing_race_6001.step" schema="AP214"/>
    <stl source="b_solid" filename="deep_groove_bearing_race_6001.stl" format="binary"/>
  </exports>
</cdml>

<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="heatsink_w" value="55.00" min="25.0" max="150.0" unit="mm"/>
    <var id="fin_height" value="25.00" min="10.0" max="60.0" unit="mm"/>
    <var id="heatsink_len" value="70.00" min="20.0" max="200.0" unit="mm"/>
    <assert expr="fin_height > 5.0" message="Fin height must provide adequate convection area" level="error"/>
  </defs>
  <body>
    <chart id="ch_xy">
      <vars>
        <vec3 id="p0" x="0.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e1" x="1.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e2" x="0.0" y="1.0" z="0.0" fixed="false"/>
      </vars>
      <constraints>
        <residual id="u2" expr="dot(e2, e2) - 1.0"/>
        <residual id="or" expr="dot(e1, e2)"/>
        <residual id="pz" expr="dot(e2, vec3(0, 0, 1))"/>
      </constraints>
    </chart>
    <sketch id="sk_heatsink" chart="ch_xy" max-iter="100">
      <vars>
                <point2d id="c0" u="0.0" v="0.0"/>
        <point2d id="c1" u="55.0000" v="0.0"/>

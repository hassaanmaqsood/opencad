      </vars>
      <wire id="w_outer" closed="true" role="outer">
                <line p0="c0" p1="c1"/>
        <line p0="c1" p1="c2"/>
        <line p0="c2" p1="fn_7_r"/>
        <line p0="fn_7_r" p1="fn_7_l"/>
        <line p0="fn_7_l" p1="fn_7_b"/>
        <line p0="fn_7_b" p1="fn_6_r"/>

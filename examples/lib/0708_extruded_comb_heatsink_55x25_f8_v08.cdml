        <line p0="fn_0_l" p1="fn_0_b"/>
        <line p0="fn_0_b" p1="c_end"/>
        <line p0="c_end" p1="c0"/>
      </wire>
    </sketch>
    <brep id="b_solid">
      <solid_extrude sketch="sk_heatsink" distance="heatsink_len" direction="vec3(0, 0, 1)"/>

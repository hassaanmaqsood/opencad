        <line p0="gb_14" p1="gb_15"/>
        <line p0="gb_15" p1="gb_0"/>
      </wire>
    </sketch>
    <brep id="b_solid">
      <solid_extrude sketch="sk_geneva" distance="wheel_thk" direction="vec3(0, 0, 1)"/>
    </brep>
  </body>
  <exports>
    <tessellate source="b_solid" linear_deflection="0.01" angular_deflection="0.1"/>
    <step source="b_solid" filename="geneva_mechanism_wheel_s4_r46_v13.step" schema="AP214"/>
    <stl source="b_solid" filename="geneva_mechanism_wheel_s4_r46_v13.stl" format="binary"/>
  </exports>
</cdml>

        <point2d id="gw_10" u="-32.5269" v="-32.5269"/>
        <point2d id="gw_11" u="-17.6034" v="-42.4985"/>
        <point2d id="gw_12" u="-0.0000" v="-46.0000"/>
        <point2d id="gw_13" u="17.6034" v="-42.4985"/>
        <point2d id="gw_14" u="32.5269" v="-32.5269"/>
        <point2d id="gw_15" u="42.4985" v="-17.6034"/>
                <point2d id="gb_0" u="6.0000" v="0.0000"/>
        <point2d id="gb_1" u="5.5433" v="2.2961"/>
        <point2d id="gb_2" u="4.2426" v="4.2426"/>
        <point2d id="gb_3" u="2.2961" v="5.5433"/>
        <point2d id="gb_4" u="0.0000" v="6.0000"/>
        <point2d id="gb_5" u="-2.2961" v="5.5433"/>
        <point2d id="gb_6" u="-4.2426" v="4.2426"/>
        <point2d id="gb_7" u="-5.5433" v="2.2961"/>
        <point2d id="gb_8" u="-6.0000" v="0.0000"/>
        <point2d id="gb_9" u="-5.5433" v="-2.2961"/>
        <point2d id="gb_10" u="-4.2426" v="-4.2426"/>
        <point2d id="gb_11" u="-2.2961" v="-5.5433"/>
        <point2d id="gb_12" u="-0.0000" v="-6.0000"/>
        <point2d id="gb_13" u="2.2961" v="-5.5433"/>
        <point2d id="gb_14" u="4.2426" v="-4.2426"/>
        <point2d id="gb_15" u="5.5433" v="-2.2961"/>
      </vars>
      <wire id="w_outer" closed="true" role="outer">
                <line p0="gw_0" p1="gw_1"/>
        <line p0="gw_1" p1="gw_2"/>
        <line p0="gw_2" p1="gw_3"/>
        <line p0="gw_3" p1="gw_4"/>
        <line p0="gw_4" p1="gw_5"/>
        <line p0="gw_5" p1="gw_6"/>
        <line p0="gw_6" p1="gw_7"/>

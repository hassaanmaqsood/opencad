        <line p0="gw_10" p1="gw_11"/>
        <line p0="gw_11" p1="gw_12"/>
        <line p0="gw_12" p1="gw_13"/>
        <line p0="gw_13" p1="gw_14"/>
        <line p0="gw_14" p1="gw_15"/>
        <line p0="gw_15" p1="gw_0"/>
      </wire>
      <wire id="w_inner" closed="true" role="inner">
                <line p0="gb_0" p1="gb_1"/>
        <line p0="gb_1" p1="gb_2"/>
        <line p0="gb_2" p1="gb_3"/>
        <line p0="gb_3" p1="gb_4"/>
        <line p0="gb_4" p1="gb_5"/>

<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="wheel_radius" value="46.00" min="20.0" max="150.0" unit="mm"/>
    <var id="wheel_thk" value="8.00" min="4.0" max="30.0" unit="mm"/>
    <assert expr="wheel_radius > 15.0" message="Wheel radius must safely accommodate slot depth" level="error"/>
  </defs>
  <body>
    <chart id="ch_xy">
      <vars>
        <vec3 id="p0" x="0.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e1" x="1.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e2" x="0.0" y="1.0" z="0.0" fixed="false"/>
      </vars>
      <constraints>
        <residual id="u2" expr="dot(e2, e2) - 1.0"/>
        <residual id="or" expr="dot(e1, e2)"/>
        <residual id="pz" expr="dot(e2, vec3(0, 0, 1))"/>
      </constraints>
    </chart>
    <sketch id="sk_geneva" chart="ch_xy" max-iter="100">
      <vars>
                <point2d id="gw_0" u="46.0000" v="0.0000"/>
        <point2d id="gw_1" u="42.4985" v="17.6034"/>

        <point2d id="f_out_22" u="17.3205" v="-10.0000"/>
        <point2d id="f_out_23" u="19.3185" v="-5.1764"/>
                <point2d id="f_in_0" u="10.0000" v="0.0000"/>
        <point2d id="f_in_1" u="9.6593" v="2.5882"/>
        <point2d id="f_in_2" u="8.6603" v="5.0000"/>
        <point2d id="f_in_3" u="7.0711" v="7.0711"/>

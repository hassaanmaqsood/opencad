        <point2d id="f_in_11" u="-9.6593" v="2.5882"/>
        <point2d id="f_in_12" u="-10.0000" v="0.0000"/>
        <point2d id="f_in_13" u="-9.6593" v="-2.5882"/>
        <point2d id="f_in_14" u="-8.6603" v="-5.0000"/>
        <point2d id="f_in_15" u="-7.0711" v="-7.0711"/>
        <point2d id="f_in_16" u="-5.0000" v="-8.6603"/>
        <point2d id="f_in_17" u="-2.5882" v="-9.6593"/>
        <point2d id="f_in_18" u="-0.0000" v="-10.0000"/>
        <point2d id="f_in_19" u="2.5882" v="-9.6593"/>
        <point2d id="f_in_20" u="5.0000" v="-8.6603"/>
        <point2d id="f_in_21" u="7.0711" v="-7.0711"/>
        <point2d id="f_in_22" u="8.6603" v="-5.0000"/>
        <point2d id="f_in_23" u="9.6593" v="-2.5882"/>
      </vars>
      <wire id="w_outer" closed="true" role="outer">
                <line p0="f_out_0" p1="f_out_1"/>
        <line p0="f_out_1" p1="f_out_2"/>
        <line p0="f_out_2" p1="f_out_3"/>

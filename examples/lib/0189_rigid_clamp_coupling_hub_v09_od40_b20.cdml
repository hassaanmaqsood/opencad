<cdml version="1.0" units="mm" linear_tol="1e-7" angular_tol="1e-11">
  <imports/>
  <defs>
    <var id="flange_od" value="40.00" min="32.00" max="48.00" unit="mm"/>
    <var id="shaft_bore" value="20.00" min="16.00" max="24.00" unit="mm"/>
    <var id="hub_len" value="44.00" min="22.00" max="88.00" unit="mm"/>
    <assert expr="flange_od > shaft_bore * 2.0" message="Hub OD must be at least twice bore" level="error"/>
  </defs>
  <body>
    <chart id="ch_xy">
      <vars>
        <vec3 id="p0" x="0.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e1" x="1.0" y="0.0" z="0.0" fixed="true"/>
        <vec3 id="e2" x="0.0" y="1.0" z="0.0" fixed="false"/>
      </vars>
      <constraints>
        <residual id="u2" expr="dot(e2, e2) - 1.0"/>
        <residual id="or" expr="dot(e1, e2)"/>
        <residual id="pz" expr="dot(e2, vec3(0, 0, 1))"/>
      </constraints>
    </chart>
    <sketch id="sk_hub" chart="ch_xy" max-iter="100">
      <vars>
                <point2d id="f_out_0" u="20.0000" v="0.0000"/>

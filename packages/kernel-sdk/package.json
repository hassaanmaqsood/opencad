{
  "name": "@open-cad/kernel-wasm",
  "version": "0.2.0",
  "description": "Zero-dependency TypeScript/JavaScript SDK and WebAssembly wrapper for OpenCAD B-Rep & Multi-Workbench Kernel",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "opencad": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli.js",
      "types": "./dist/cli.d.ts"
    },
    "./core": {
      "import": "./dist/core.js",
      "types": "./dist/core.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "../../web-app/node_modules/.bin/tsc || tsc",
    "test": "node --test test/**/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "keywords": [
    "cad",
    "b-rep",
    "parametric",
    "webassembly",
    "sheet-metal",
    "fea",
    "flexure",
    "implicit",
    "sdf",
    "cam",
    "hlr"
  ],
  "author": "OpenCAD Team",
  "license": "Apache-2.0"
}
